# KWin window rules for the (T)rustyShelf session (system-wide).
# A profile's own ~/.config/kwinrulesrc would replace this list, not add to it
# (its [General] count / rules win), so rules belong here.
#
# 1. Every dialog ((T)rustyShelf's file pickers, an emulator's settings window)
#    opens in the middle of the screen. With kwinrc's Placement=Maximizing
#    they went to the top-left corner, where a dialog taller than the screen
#    had its buttons cut off. Normal windows (the games) still open maximized.
# 2. (T)rustyShelf's own dialogs also stay above its fullscreen window. Other
#    programs' dialogs aren't forced on top: one left open behind a game must
#    not float over the shelf afterwards.
[General]
count=2
rules=dialogs-centered,trustyshelf-dialogs-above

[dialogs-centered]
Description=Dialogs: centered
types=32
placement=5
placementrule=2

[trustyshelf-dialogs-above]
Description=(T)rustyShelf's dialogs: above the shelf
types=32
wmclass=^(trustyshelf|boxshelf)-bin$
wmclassmatch=3
above=true
aboverule=2
